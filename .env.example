# Friday Pharma — environment variables
#
# এই অ্যাপ অফলাইন-ফার্স্ট। সব তথ্য আগে এই ডিভাইসের IndexedDB-তে (Dexie,
# ডেটাবেসের নাম `asshifa_local`) জমা হয়। নিচের কোনো চলক না দিলেও অ্যাপ
# সম্পূর্ণ চলে — সেটিই স্বাভাবিক ব্যবহার, কোনো ত্রুটি নয়।
#
# এই ফাইলটি `.env.local` নামে কপি করে মান বসাতে হয়। `.env.local` git-এ যায় না।
#   cp .env.example .env.local


# ------------------------------------------------------------------
# Supabase (একাধিক দোকান / ক্লাউড) — ঐচ্ছিক
# ------------------------------------------------------------------
# দুটিই না দিলে:  ক্লাউড অংশ (লগইন, নতুন দোকান, আমন্ত্রণ কোড) লুকানো থাকে,
#                 অ্যাপ শুধু এই ডিভাইসে ৮ সংখ্যার PIN দিয়ে চলে। সমর্থিত অবস্থা।
#
# দুটিই দিলে:     লগইন, দোকান তৈরি, আমন্ত্রণ কোডে যোগ দেওয়া ও দোকান বদল চালু হয়।
#
# একটি দিয়ে অন্যটি না দিলে, বা মান বিকৃত হলে: অ্যাপ সঙ্গে সঙ্গে জোরে অভিযোগ করে
#                 এবং কোন চলকটি ভুল তা নাম ধরে দেখায়। dummy মান দিয়ে কখনো
#                 সংযোগ তৈরি হয় না — নিঃশব্দে "কাজ করছে বলে মনে হওয়া" চলবে না।
#
# মান পাওয়া যায়: Supabase Dashboard → Project Settings → API
# স্থানীয়ভাবে `supabase start` চালালে সেটির দেওয়া URL ও anon key ব্যবহার করুন
# (http://localhost:54321 সম্পূর্ণ বৈধ মান)।

# NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# মন দিন — anon key ব্রাউজারে যায়, তাই এটি গোপন নয়। আসল সুরক্ষা Row Level
# Security থেকে আসে। service_role key কখনো এখানে বা ক্লায়েন্টে দেবেন না।


# ------------------------------------------------------------------
# প্রদর্শনের চলক — এখনো কোনো কোড এগুলো পড়ে না, ভবিষ্যতের জন্য রাখা
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Friday Pharma
NEXT_PUBLIC_DEFAULT_LOCALE=bn
